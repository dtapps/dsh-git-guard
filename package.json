{
  "name": "@dtapp/dsh-git-guard",
  "version": "1.0.0",
  "description": "在工具策略层阻止 agent 自行执行 git commit、push 等 git 写操作，只读 git 命令仍可用。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test.mjs",
    "prepublishOnly": "node test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://cnb.cool/dtapp/dsh-git-guard"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "git",
    "guard",
    "tool-policy"
  ],
  "license": "MIT",
  "private": false,
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
